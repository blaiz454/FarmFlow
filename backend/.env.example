# ── FarmFlow backend environment variables ────────────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file to git.

# MongoDB connection string.
# Local example:   mongodb://localhost:27017/farmflow
# Atlas example:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/farmflow?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/farmflow

# Secret used to sign JWT access tokens. Generate a long random string, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret

# How long issued JWTs stay valid, in hours.
JWT_EXPIRES_HOURS=24

# Comma-separated list of origins allowed to call this API (your frontend URL).
CORS_ORIGINS=http://localhost:5173

# Flask environment: "development" or "production"
FLASK_ENV=development

# Port the Flask dev server listens on
PORT=5000
