# ── FarmFlow frontend environment variables ───────────────────────────────
# Copy this file to `.env` (dev) and set real values for production builds.
# Vite only exposes variables prefixed with VITE_ to browser code.

# The canonical public URL of this site. Used to build canonical URLs,
# Open Graph URLs, robots.txt, and sitemap.xml. Use localhost in dev.
VITE_SITE_URL=http://localhost:5173

# Base URL of the backend API.
VITE_API_URL=http://localhost:5000
